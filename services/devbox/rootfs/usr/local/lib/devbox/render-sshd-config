#!/bin/sh
# Prints the complete sshd_config for the dev box on stdout.
#
# Inputs (environment):
#   DEVBOX_SSH_PORT       port sshd listens on (the TCP proxy target), default 22
#   DEVBOX_HOSTKEY_DIR    directory with the persistent host keys
#   DEVBOX_USER           the only account allowed to log in, default dev
#   DEVBOX_PASSWORD_AUTH  yes|no
#
# Notes:
# - Railway's TCP proxy hides the client IP (every connection comes from the
#   proxy), so per-source banning (fail2ban, PerSourcePenalties) would lock out
#   everyone. Brute force is limited by long generated passwords, MaxAuthTries,
#   LoginGraceTime and MaxStartups instead.
# - Target is OpenSSH 9.6 (Ubuntu 24.04): do not add keywords introduced later.
set -eu

port="${DEVBOX_SSH_PORT:-22}"
hostkey_dir="${DEVBOX_HOSTKEY_DIR:?DEVBOX_HOSTKEY_DIR is required}"
user="${DEVBOX_USER:-dev}"
password_auth="${DEVBOX_PASSWORD_AUTH:-no}"

case "${port}" in
  ''|*[!0-9]*) echo "render-sshd-config: invalid port '${port}'" >&2; exit 1 ;;
esac
case "${password_auth}" in
  yes|no) ;;
  *) echo "render-sshd-config: DEVBOX_PASSWORD_AUTH must be yes or no" >&2; exit 1 ;;
esac
case "${user}" in
  ''|*[!a-z0-9_-]*) echo "render-sshd-config: invalid user '${user}'" >&2; exit 1 ;;
esac

cat <<EOF
# Generated by devbox-entrypoint at every container start. Do not edit:
# changes are overwritten on the next restart.

Port ${port}
AddressFamily any

HostKey ${hostkey_dir}/ssh_host_ed25519_key
HostKey ${hostkey_dir}/ssh_host_rsa_key
PidFile /run/sshd.pid

# Who may log in, and how.
PermitRootLogin no
AllowUsers ${user}
PubkeyAuthentication yes
AuthorizedKeysFile .ssh/authorized_keys /etc/ssh/authorized_keys.d/%u
PasswordAuthentication ${password_auth}
PermitEmptyPasswords no
KbdInteractiveAuthentication no
UsePAM yes

# Brute-force and resource limits.
MaxAuthTries 3
LoginGraceTime 20
MaxStartups 10:30:60
MaxSessions 10

# Keep sessions alive through the TCP proxy.
ClientAliveInterval 30
ClientAliveCountMax 4
TCPKeepAlive yes
UseDNS no

# Port forwarding stays on (VS Code Remote-SSH, ssh -L for dev servers).
AllowTcpForwarding yes
AllowAgentForwarding yes
GatewayPorts no
PermitTunnel no
X11Forwarding no
PermitUserEnvironment no

PrintMotd no
PrintLastLog no
LogLevel VERBOSE
# Client LANG/LC_* are not accepted: macOS sends locales that do not exist
# here. Sessions get LANG=C.UTF-8 from /etc/default/locale (pam_env).
AcceptEnv COLORTERM
Subsystem sftp /usr/lib/openssh/sftp-server
EOF
