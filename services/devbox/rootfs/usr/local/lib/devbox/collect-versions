#!/bin/sh
# Prints "name|version" for the tools baked into the image. Runs at build time
# (output: /etc/devbox/versions.txt, shown on the status page and by devbox-info).
set -u

v() {
  name="$1"
  shift
  out="$("$@" 2>&1 | head -n 1 | tr -d '\r')"
  [ -n "${out}" ] || out="unavailable"
  printf '%s|%s\n' "${name}" "${out}"
}

v "Ubuntu" sh -c '. /etc/os-release && echo "${PRETTY_NAME}"'
v "Claude Code" claude --version
v "OpenAI Codex CLI" codex --version
v "Gemini CLI" gemini --version
v "OpenCode" opencode --version
v "Node.js" node --version
v "npm" npm --version
v "Python" python3 --version
v "uv" uv --version
v "pipx" pipx --version
v "git" git --version
v "GitHub CLI" gh --version
v "tmux" tmux -V
v "ripgrep" rg --version
v "OpenSSH" ssh -V
v "ttyd" ttyd --version
v "Caddy" caddy version
