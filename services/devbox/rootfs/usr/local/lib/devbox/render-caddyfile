#!/bin/sh
# Prints the Caddyfile for the HTTP front on $PORT.
#
# Inputs (environment):
#   DEVBOX_HTTP_PORT     listen port (Railway's PORT)
#   DEVBOX_WEB_USER      basic auth user name
#   DEVBOX_WEB_HASH      bcrypt hash of WEB_PASSWORD (from caddy hash-password)
#   DEVBOX_WEB_TERMINAL  true|false: proxy /terminal* to ttyd
#   DEVBOX_TTYD_PORT     ttyd port on 127.0.0.1
#   DEVBOX_WWW_DIR       directory with the rendered status page
#
# Only /healthz is public. Everything else, including the web terminal,
# requires the basic auth login.
set -eu

port="${DEVBOX_HTTP_PORT:?DEVBOX_HTTP_PORT is required}"
user="${DEVBOX_WEB_USER:?DEVBOX_WEB_USER is required}"
hash="${DEVBOX_WEB_HASH:?DEVBOX_WEB_HASH is required}"
terminal="${DEVBOX_WEB_TERMINAL:-false}"
ttyd_port="${DEVBOX_TTYD_PORT:-7681}"
www_dir="${DEVBOX_WWW_DIR:?DEVBOX_WWW_DIR is required}"

fail() { echo "render-caddyfile: $*" >&2; exit 1; }

case "${port}" in ''|*[!0-9]*) fail "invalid port '${port}'" ;; esac
case "${ttyd_port}" in ''|*[!0-9]*) fail "invalid ttyd port '${ttyd_port}'" ;; esac
case "${user}" in ''|*[!a-z0-9_-]*) fail "invalid user '${user}'" ;; esac
case "${hash}" in
  '$2a$'*|'$2b$'*|'$2y$'*) ;;
  *) fail "DEVBOX_WEB_HASH is not a bcrypt hash" ;;
esac
case "${hash}" in *[!A-Za-z0-9./\$]*) fail "DEVBOX_WEB_HASH has unexpected characters" ;; esac
case "${www_dir}" in /*) ;; *) fail "DEVBOX_WWW_DIR must be absolute" ;; esac
case "${www_dir}" in *[!A-Za-z0-9/._-]*) fail "DEVBOX_WWW_DIR has unexpected characters" ;; esac

cat <<EOF
# Generated by devbox-entrypoint at every container start. Do not edit.
{
	admin off
	auto_https off
	persist_config off
	log {
		output stderr
		format console
		level INFO
	}
}

:${port} {
	@protected not path /healthz
	basic_auth @protected bcrypt "Ubuntu Dev Box" {
		${user} ${hash}
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}

	handle /healthz {
		header Cache-Control no-store
		respond "ok" 200
	}
EOF

if [ "${terminal}" = "true" ]; then
  cat <<EOF

	handle /terminal* {
		reverse_proxy 127.0.0.1:${ttyd_port}
	}
EOF
fi

cat <<EOF

	handle {
		header Cache-Control no-store
		root * ${www_dir}
		file_server
	}
}
EOF
